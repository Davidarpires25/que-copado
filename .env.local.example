# Variables del proyecto. Copiar a `.env.local` y completar.
#
# ¡OJO! `.env.local` decide contra qué base corre la app. Si tiene las claves de
# producción, todo lo que hagas en el navegador le pasa al local de verdad.

# ─── Producción ─────────────────────────────────────────────────────────────
# Las de tu proyecto en Supabase (Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

NEXT_PUBLIC_WHATSAPP_NUMBER=<numero de whatsapp del local>
NEXT_PUBLIC_SENTRY_DSN=<dsn de sentry, opcional>

# Secreto compartido con el agente de WhatsApp (ver README).
AGENT_API_SECRET=<un secreto largo>

# ─── Base local de prueba ───────────────────────────────────────────────────
# Para probar sin tocar producción: `npm run db:start` y reemplazar las tres
# primeras variables por estas. Son las mismas en cualquier instalación de
# Supabase local, así que no son secretas.
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
#
# Usuario de prueba: prueba@local.test / prueba1234
